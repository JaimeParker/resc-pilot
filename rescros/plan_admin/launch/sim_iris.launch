<launch>
    <!-- RL params -->
    <arg name="model_name" value="2024-09-26_09-44.pt"/>
    <arg name="num_obs" value="25"/>
    <arg name="wpt_tolerance" value="0.65"/>
    <!-- control type: 0 for rate+thrust, 1 for thrusts -->
    <arg name="control_type" value="0"/>

    <!-- Map size -->
    <arg name="map_size_x" value="40.0"/>
    <arg name="map_size_y" value="20.0"/>
    <arg name="map_size_z" value="3.0"/>
    <!-- Geo fence only in real flight mode -->
    <arg name="gen_fence_x" value="5.0"/>
    <arg name="gen_fence_y" value="3.0"/>
    <arg name="num_obstacles" value="200"/>

    <!-- env setting -->
    <arg name="start_x" value="-18.0"/>
    <arg name="start_y" value="-8.0"/>
    <arg name="start_z" value="1.0"/>

    <!-- Drone params -->
    <arg name="drone_id" value="iris"/>
    <arg name="mass" value="0.535" />
    <arg name="ixx" value="0.029125" />
    <arg name="iyy" value="0.029125" />
    <arg name="izz" value="0.055225" />
    <arg name="arm_x" value="0.13" />
    <arg name="arm_y_long" value="0.22" />
    <arg name="arm_y_short" value="0.2" />
    <arg name="torque_constant" value="0.12" />
    <arg name="rescaled_thrust_min" value="0.0" />
    <arg name="rescaled_thrust_max" value="1.0" />
    <!-- set the body rate in degrees -->
    <arg name="body_rate_max" value="120"/>
    <arg name="yaw_rate_max" value="60"/>

    <!-- ROS utils -->
    <arg name="sub_queue_size" value="1"/>
    <arg name="pub_queue_size" value="1"/>
    <arg name="rl_att_cmd_topic" value="/rl_att_cmd"/>
    <arg name="pose_sub_topic" value="/mavros/local_position/pose"/>
    <arg name="vel_sub_topic" value="/mavros/local_position/velocity_local"/>
    <arg name="accel_sub_topic" value="/mavros/imu/data"/>
    <arg name="body_rate_sub_topic" value="/mavros/local_position/velocity_body"/>

    <!-- QGC and PX4 params -->
    <arg name="pwm_min" value="1000"/>
    <arg name="pwm_max" value="2000"/>

    <!-- mogen simulator -->
    <!-- 0 for using real map, 1 for using randomized map -->
    <arg name="use_randomized_map" value="1"/>

    <!-- Planning node -->
    <include file="$(find plan_admin)/launch/rl_plan.xml">
        <!-- RL params -->
        <arg name="policy_model_" value="$(arg model_name)"/>
        <arg name="env_num_obs_" value="$(arg num_obs)"/>
        <arg name="env_wpt_tolerance_" value="$(arg wpt_tolerance)"/>
        <arg name="rl_ctrl_type_" value="$(arg control_type)"/>

        <!-- Map Size -->
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        <arg name="geo_fence_x_" value="$(arg gen_fence_x)"/>
        <arg name="geo_fence_y_" value="$(arg gen_fence_y)"/>
        <arg name="num_obstacles_" value="$(arg num_obstacles)"/>

        <!-- Drone params -->
        <arg name="drone_id_" value="$(arg drone_id)"/>
        <arg name="mass_" value="$(arg mass)"/>
        <arg name="ixx_" value="$(arg ixx)"/>
        <arg name="iyy_" value="$(arg iyy)"/>
        <arg name="izz_" value="$(arg izz)"/>
        <arg name="arm_x_" value="$(arg arm_x)"/>
        <arg name="arm_y_long_" value="$(arg arm_y_long)"/>
        <arg name="arm_y_short_" value="$(arg arm_y_short)"/>
        <arg name="torque_constant_" value="$(arg torque_constant)"/>
        <arg name="rescaled_thrust_min_" value="$(arg rescaled_thrust_min)"/>
        <arg name="rescaled_thrust_max_" value="$(arg rescaled_thrust_max)"/>
        <arg name="body_rate_max_" value="$(arg body_rate_max)"/>
        <arg name="yaw_rate_max_" value="$(arg yaw_rate_max)"/>

        <!-- ROS utils -->
        <arg name="rl_att_cmd_topic_" value="$(arg rl_att_cmd_topic)"/>
        <arg name="sub_queue_size_" value="$(arg sub_queue_size)"/>
        <arg name="pub_queue_size_" value="$(arg pub_queue_size)"/>
        <arg name="pose_sub_topic_" value="$(arg pose_sub_topic)"/>
        <arg name="vel_sub_topic_" value="$(arg vel_sub_topic)"/>
        <arg name="accel_sub_topic_" value="$(arg accel_sub_topic)"/>
        <arg name="body_rate_sub_topic_" value="$(arg body_rate_sub_topic)"/>

        <!-- QGC and PX4 params -->
        <arg name="pwm_min_" value="$(arg pwm_min)"/>
        <arg name="pwm_max_" value="$(arg pwm_max)"/>

        <!-- mogen simulator -->
        <arg name="use_sim_map_" value="$(arg use_randomized_map)"/>
    </include>

    <!-- simulator node -->
    <node pkg="mogen_simulator" name="mogen_simulator_node" type="mogen_simulator_node" output="screen">
    	<param name="sim/rl_att_cmd_topic" value="$(arg rl_att_cmd_topic)" type="str"/>
    	<param name="sim/pose_sub_topic" value="$(arg pose_sub_topic)" type="str"/>
    	<param name="sim/vel_sub_topic" value="$(arg vel_sub_topic)" type="str"/>
    	<param name="sim/body_rate_sub_topic" value="$(arg body_rate_sub_topic)" type="str"/>
    	<param name="sim/ground_height" value="0.0" type="double"/>
    	<param name="sim/dt" value="0.02" type="double"/>
    	<param name="sim/drone" value="drone_id" type="str"/>

    	<param name="sim/start_x" value="$(arg start_x)" type="double"/>
    	<param name="sim/start_y" value="$(arg start_y)" type="double"/>
    	<param name="sim/start_z" value="$(arg start_z)" type="double"/>
    </node>

</launch>
